{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harkers/.github/workitem/provenance.schema.json",
  "title": "Resolved WorkItem contract provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "requested_ref",
    "resolved_sha",
    "path",
    "contract_version",
    "fetched_at",
    "checksum"
  ],
  "properties": {
    "repo": { "type": "string", "const": "harkers/.github" },
    "requested_ref": {
      "type": "string",
      "pattern": "^workitem/v[0-9]+(\\.[0-9]+)*$",
      "description": "Must be a pinned contract tag. An unpinned moving ref such as main or HEAD is rejected."
    },
    "resolved_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)*$" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}