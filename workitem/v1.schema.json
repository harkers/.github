{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harkers/.github/workitem/v1.schema.json",
  "title": "WorkItem v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "id", "identity", "hierarchy", "source", "priority",
    "state", "scope", "privacy", "delivery", "execution", "dependencies",
    "acceptance_criteria", "verification", "sizing", "artifacts", "attempts",
    "completion", "timestamps"
  ],
  "properties": {
    "schema": { "const": "workitem" },
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^WI-[0-9]{8}-[0-9]{4}$" },

    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "title", "description"],
      "properties": {
        "type": { "enum": ["TASK", "BUG", "FEATURE", "INVESTIGATION", "CHORE", "DOCS", "SPIKE", "REFACTOR"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },

    "hierarchy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "epic": { "type": ["string", "null"] },
        "parent": { "type": ["string", "null"], "pattern": "^WI-[0-9]{8}-[0-9]{4}$" }
      }
    },

    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "issue", "requested_by", "created_by"],
      "properties": {
        "type": { "enum": ["user_request", "github_issue", "review_finding", "bug_report", "decomposition", "imported"] },
        "issue": { "type": ["integer", "null"], "minimum": 1 },
        "requested_by": { "type": "string", "minLength": 1 },
        "created_by": { "type": "string", "minLength": 1 }
      }
    },

    "priority": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "state": { "type": "string", "minLength": 1 },

    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_paths", "denied_paths"],
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "denied_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },

    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "network"],
      "properties": {
        "level": { "enum": ["PUBLIC", "INTERNAL", "CLIENT_CONFIDENTIAL", "LOCAL_ONLY"] },
        "network": { "enum": ["allowed", "denied"] }
      }
    },

    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "branch", "pull_request"],
      "properties": {
        "mode": { "enum": ["pull_request", "branch_only", "none"] },
        "branch": { "type": ["string", "null"] },
        "pull_request": { "type": ["integer", "null"], "minimum": 1 }
      }
    },

    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_role", "capability", "preferred_model", "resource_class", "max_attempts"],
      "properties": {
        "worker_role": { "type": ["string", "null"] },
        "capability": { "type": ["string", "null"] },
        "preferred_model": { "type": ["string", "null"] },
        "resource_class": { "type": "string", "minLength": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "type"],
        "properties": {
          "target": { "type": "string", "pattern": "^WI-[0-9]{8}-[0-9]{4}$" },
          "type": { "enum": ["BLOCKS", "REQUIRES", "OPTIONAL", "QUALITY_GATE", "REVIEW_GATE"] }
        }
      }
    },

    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "status", "verification_method", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "met", "unmet", "waived"] },
          "verification_method": { "enum": ["command", "artifact", "named_check"] },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },

    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["review_policy", "required", "tests", "local_review", "cloud_review", "specialist_review"],
      "properties": {
        "review_policy": { "enum": ["low_risk", "normal", "security_sensitive", "high_risk"] },
        "required": {
          "type": "array",
          "items": { "enum": ["tests", "local_review", "cloud_review", "specialist_review"] }
        },
        "tests":             { "$ref": "#/$defs/verificationCheck" },
        "local_review":      { "$ref": "#/$defs/verificationCheck" },
        "cloud_review":      { "$ref": "#/$defs/verificationCheck" },
        "specialist_review": { "$ref": "#/$defs/verificationCheck" }
      }
    },

    "sizing": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_complexity", "estimated_context_tokens"],
      "properties": {
        "estimated_complexity": { "enum": ["SMALL", "MEDIUM", "LARGE", "XL"] },
        "estimated_context_tokens": { "type": "integer", "minimum": 0 }
      }
    },

    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["specification", "implementation_plan", "commits", "completion_packet"],
      "properties": {
        "specification": { "type": ["string", "null"] },
        "implementation_plan": { "type": ["string", "null"] },
        "commits": { "type": "array", "items": { "type": "string" } },
        "completion_packet": { "type": ["string", "null"] }
      }
    },

    "attempts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["run_id", "dispatched_at", "outcome"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "dispatched_at": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 }
        }
      }
    },

    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "packet"],
      "properties": {
        "status": { "enum": ["incomplete", "complete"] },
        "packet": { "type": ["string", "null"] }
      }
    },

    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["created_at", "updated_at", "started_at", "completed_at"],
      "properties": {
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] }
      }
    }
  },

  "$defs": {
    "verificationCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed", "not_applicable"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "exit_code": { "type": "integer" },
              "result": { "type": "string" },
              "reviewer": { "type": "string" },
              "report": { "type": "string" }
            }
          }
        }
      }
    }
  }
}